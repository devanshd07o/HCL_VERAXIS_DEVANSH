# MULTIINTEL AI / VERAXIS AI - Environment Configuration Template

# Groq API Keys:
# Provide comma-separated keys for automatic round-robin rotation & rate-limit failover
GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3
# Or provide a single key:
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: Path to custom keys file (e.g. ./groq_keys.txt)
# GROQ_KEYS_FILE=

# Fallback LLM: Google Gemini Free Tier
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection
GROQ_PRIMARY_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
